# Copy to .env and adjust. All values are optional; these are the defaults.
PORT=3000
# 127.0.0.1 = only this computer can reach the server. Use 0.0.0.0 to listen on the network.
HOST=127.0.0.1
# Largest upload per file, in MB, and how many files one request may send.
MAX_FILE_MB=20
MAX_FILES=10
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
